local function set(object, values)
    for key, value in pairs(values) do object[key] = value end
    return object
end
local function make(class, values, parent)
    local object = Instance.new(class)
    local ok, err = pcall(function()
        set(object, values or {})
        object.Parent = parent
    end)
    if not ok then object:Destroy(); error(err, 2) end
    return object
end
local function owned(class, name, parent, values)
    local object = make(class, values, nil)
    local ok, err = pcall(function()
        object.Name = "ShadersX_" .. name
        object:SetAttribute(OWNER, true)
        object.Parent = parent
    end)
    if not ok then object:Destroy(); error(err, 2) end
    return object
end
local function snapshot(object, names)
    local values = {}
    for _, key in ipairs(names) do
        local ok, value = pcall(function() return object[key] end)
        if ok and value ~= nil then values[key] = value end
    end
    return values
end
local function restore(object, values)
    for key, value in pairs(values) do
        pcall(function() object[key] = value end)
    end
end

-- CleanupManager: bounded ownership of connections, tasks and instances.
local CleanupManager = {}
CleanupManager.__index = CleanupManager
function CleanupManager.new()
    return setmetatable({items = {}, dead = false}, CleanupManager)
end
function CleanupManager:Add(item, dispose)
    local release = dispose or function(value) value:Destroy() end
    if self.dead then pcall(release, item) else self.items[item] = release end
    return item
end
function CleanupManager:Connect(signal, callback)
    return self:Add(signal:Connect(callback), function(c) c:Disconnect() end)
end
function CleanupManager:Delay(seconds, callback)
    if self.dead then return end
    local thread
    thread = task.delay(seconds, function()
        self.items[thread] = nil
        if not self.dead then callback() end
    end)
    return self:Add(thread, function(t) pcall(task.cancel, t) end)
end
function CleanupManager:Destroy()
    if self.dead then return end
    self.dead = true
    local items = self.items
    self.items = {}
    for item, dispose in pairs(items) do pcall(dispose, item) end
end

-- TransitionManager: one tween per object, cancellable timers, no orphaned completion callbacks.
local TransitionManager = {}
TransitionManager.__index = TransitionManager
function TransitionManager.new()
    return setmetatable({running = {}, scope = CleanupManager.new(), generation = 0}, TransitionManager)
end
function TransitionManager:Cancel(object)
    local entry = self.running[object]
    if entry then
        self.running[object] = nil
        entry.connection:Disconnect()
        entry.tween:Cancel()
    end
end
function TransitionManager:Reset()
    self.generation += 1
    for object in pairs(self.running) do self:Cancel(object) end
    self.scope:Destroy()
    self.scope = CleanupManager.new()
    return self.generation
end
function TransitionManager:To(object, goals, seconds, callback, style, direction)
    self:Cancel(object)
    local tween = TweenService:Create(object,
        TweenInfo.new(seconds or 0.25, style or Enum.EasingStyle.Sine, direction or Enum.EasingDirection.InOut), goals)
    local entry = {tween = tween}
    entry.connection = tween.Completed:Connect(function(state)
        if self.running[object] ~= entry then return end
        self.running[object] = nil
        entry.connection:Disconnect()
        if state == Enum.PlaybackState.Completed and callback then callback() end
    end)
    self.running[object] = entry
    tween:Play()
    return tween
end
function TransitionManager:After(seconds, callback)
    return self.scope:Delay(seconds, callback)
end
function TransitionManager:Clock(target, seconds)
    -- Shortest arc across midnight rather than an unwanted trip through noon.
    local start = Lighting.ClockTime
    local delta = (target - start + 12) % 24 - 12
    local proxy = self.scope:Add(make("NumberValue", {Value = start}))
    local connection = self.scope:Connect(proxy:GetPropertyChangedSignal("Value"), function()
        Lighting.ClockTime = proxy.Value % 24
    end)
    self:To(proxy, {Value = start + delta}, seconds, function()
        Lighting.ClockTime = target
        connection:Disconnect()
        self.scope.items[connection] = nil
        self.scope.items[proxy] = nil
        proxy:Destroy()
    end)
end
function TransitionManager:Destroy()
    self:Reset()
    self.scope:Destroy()
end

