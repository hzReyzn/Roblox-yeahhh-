        UDim2.fromOffset(2, 9), UDim2.new(1, -4, 0, 16), Enum.Font.GothamMedium)
    local skyButton = button(settings, "CustomSkybox", "", UDim2.fromOffset(0, 32), UDim2.new(1, 0, 0, 49))
    stroke(skyButton, Palette.border, 0.65)
    label(skyButton, "Name", "Custom skybox", 14, Palette.text,
        UDim2.fromOffset(11, 6), UDim2.new(1, -80, 0, 21), Enum.Font.GothamMedium)
    self.skyNote = label(skyButton, "Source", "Preset-matched panoramas", 11, Palette.muted,
        UDim2.fromOffset(11, 29), UDim2.new(1, -70, 0, 14))
    self.skySwitch = make("Frame", {Name = "Switch", BackgroundColor3 = rgb(73, 53, 107), BorderSizePixel = 0,
        Position = UDim2.new(1, -51, 0, 13), Size = UDim2.fromOffset(39, 23)}, skyButton)
    corner(self.skySwitch, 12)
    self.skyThumb = make("Frame", {Name = "Thumb", BackgroundColor3 = Palette.accent, BorderSizePixel = 0,
        Position = UDim2.fromOffset(19, 3), Size = UDim2.fromOffset(17, 17)}, self.skySwitch)
    corner(self.skyThumb, 9)
    self:Bind(skyButton, function() manager:SetSkybox(not manager.customSky) end)
    label(settings, "QualityLabel", "Visual quality", 13, Palette.text, UDim2.fromOffset(2, 92), UDim2.fromOffset(180, 18))
    for index, name in ipairs(GraphicsProfiles.Order) do
        local column, row = (index - 1) % 2, math.floor((index - 1) / 2)
        local item = button(settings, name, name, UDim2.new(column * 0.5, column == 0 and 0 or 4, 0, 118 + row * 52),
            UDim2.new(0.5, -4, 0, 44))
        item.TextSize = 13
        local edge = stroke(item, Palette.border, 0.6)
        self.profiles[name] = {button = item, stroke = edge}
        self:Bind(item, function() manager:SetQuality(name) end)
    end
    local footer = make("Frame", {Name = "Footer", BorderSizePixel = 0, BackgroundColor3 = Palette.base,
        Position = UDim2.new(0, 0, 1, -64), Size = UDim2.new(1, 0, 0, 64)}, window)
    local disable = button(footer, "DisableAllShaders", "Disable All Shaders", UDim2.fromOffset(16, 8), UDim2.new(1, -32, 0, 44))
    stroke(disable, Palette.border, 0.4)
    self:Bind(disable, function() manager:DisableAll() end)

    local floating = button(safe, "RestoreSX", "SX", UDim2.fromOffset(20, 28), UDim2.fromOffset(52, 52))
    floating.Visible, floating.TextSize, floating.Font = false, 17, Enum.Font.GothamBold
    floating.BackgroundColor3 = rgb(43, 35, 61)
    floating:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 16)
    local floatEdge = stroke(floating, WHITE, 0.2, 1.25)
    gradient(floatEdge, {ColorSequenceKeypoint.new(0, Palette.accent), ColorSequenceKeypoint.new(1, Palette.cool)}, 40)
    self.floating, self.floatEdge = floating, floatEdge
    self:Drag(floating, floating, function() self:RestoreWindow() end)
    -- Activated supports keyboard/gamepad. Mouse/touch tap is resolved by Drag to prevent restoring after a drag.
    self.scope:Connect(floating.Activated, function(input)
        if input and input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then self:RestoreWindow() end
    end)
    self:CreateToast()
    local shutdown = make("BindableFunction", {Name = "Shutdown"}, screen)
    shutdown.OnInvoke = function() manager:Destroy(); return true end
    self.scope:Connect(screen.Destroying, function() manager:Destroy() end)
    self.scope:Connect(safe:GetPropertyChangedSignal("AbsoluteSize"), function() self:Layout() end)
    screen.Parent = playerGui
    self:Layout()
    self.windowFade = VisibilityAnimator.new(window, self.scope)
    self:SelectView("Environments")
    self.windowFade:Set(1)
    self.windowFade:To(self.windowTweens, 0, 0.38)
    self.windowTweens:To(self.windowScale, {Scale = 1}, 0.4, nil, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    self:Refresh()
    return self
end
function UIController:Layout()
    if self.dead then return end
    local bounds = self.safe.AbsoluteSize
    if bounds.X < 100 or bounds.Y < 100 then return end
    local width = math.min(384, bounds.X - 24)
    -- Reserve the lower touch-control zone; the content scrolls instead of shrinking its text.
    local bottomReserve = UserInputService.TouchEnabled and 92 or 36
    local height = math.min(568, math.max(280, bounds.Y - bottomReserve - 16), bounds.Y - 16)
    self.window.Size = UDim2.fromOffset(width, height)
    local compact = height < 340
    local header = self.window:FindFirstChild("ActivePreset")
    header.Visible = not compact
    for _, tab in pairs(self.tabs) do
        local p = tab.button.Position
        tab.button.Position = UDim2.new(p.X.Scale, p.X.Offset, 0, compact and 70 or 128)
    end
    self.scroll.Position = UDim2.fromOffset(16, compact and 120 or 180)
    self.scroll.Size = UDim2.new(1, -32, 1, compact and -188 or -248)
    if not self.windowMoved then
        self.window.Position = UDim2.fromOffset(math.max(12, bounds.X - width - 20), 12)
    else
        local p = self.window.Position
        self.window.Position = UDim2.fromOffset(math.clamp(p.X.Offset, -width + 70, bounds.X - 70),
            math.clamp(p.Y.Offset, 0, math.max(0, bounds.Y - 52)))
    end
    if not self.floatingMoved then
        self.floating.Position = UDim2.fromOffset(math.max(12, bounds.X - 72), 16)
    else
        local p = self.floating.Position
        self.floating.Position = UDim2.fromOffset(math.clamp(p.X.Offset, 0, math.max(0, bounds.X - 52)),
            math.clamp(p.Y.Offset, 0, math.max(0, bounds.Y - 52)))
    end
    if self.toast then self.toast.Size = UDim2.fromOffset(math.min(326, bounds.X - 24), 76) end
end
function UIController:SelectView(name)
    self.presetGrid.Visible = name == "Environments"
    self.settingsView.Visible = name == "Settings"
    self.scroll.CanvasPosition = Vector2.zero
    for key, tab in pairs(self.tabs) do
        local selected = key == name
        tab.button.BackgroundColor3 = selected and rgb(63, 47, 89) or Palette.raised
        tab.button.TextColor3 = selected and WHITE or Palette.muted
        tab.stroke.Color = selected and Palette.accent or Palette.border
        self.windowFade:Base(tab.stroke, "Transparency", selected and 0.20 or 0.65)
    end
end
function UIController:Refresh()
    if self.dead then return end
    local manager = self.manager
    local preset = manager.active and Presets[manager.active]
    self.activeLabel.Text = manager.active or "Original environment"
    if manager.phase == "Applying" then self.phaseLabel.Text = "Blending environment…"
    elseif manager.phase == "Restoring" then self.phaseLabel.Text = "Restoring original lighting…"
    elseif manager.active then self.phaseLabel.Text = "ACTIVE  ·  " .. manager.quality
    else self.phaseLabel.Text = "Select an environment below" end
    self.tweens:To(self.dot, {BackgroundColor3 = preset and preset.accent or Palette.muted}, 0.25)
    for name, item in pairs(self.buttons) do
        local selected = manager.active == name
        item.state.Text = selected and "ON" or "OFF"
        item.state.TextColor3 = selected and Presets[name].accent or Palette.muted
        self.tweens:To(item.stroke, {Color = selected and Presets[name].accent or Palette.border}, 0.22)
        self.windowFade:Base(item.stroke, "Transparency", selected and 0 or 0.42)
        self.windowFade:Base(item.badge, "BackgroundTransparency", selected and 0.72 or 0.90)
    end
    for name, item in pairs(self.profiles) do
        local selected = manager.quality == name
        item.button.BackgroundColor3 = selected and rgb(52, 39, 76) or Palette.raised
        self.tweens:To(item.stroke, {Color = selected and Palette.accent or Palette.border}, 0.2)
        self.windowFade:Base(item.stroke, "Transparency", selected and 0.1 or 0.5)
    end
    self.tweens:To(self.skySwitch, {BackgroundColor3 = manager.customSky and rgb(73, 53, 107) or rgb(42, 42, 52)}, 0.2)
    self.tweens:To(self.skyThumb, {Position = UDim2.fromOffset(manager.customSky and 19 or 3, 3),
        BackgroundColor3 = manager.customSky and Palette.accent or Palette.muted}, 0.22)
    if not manager.customSky then self.skyNote.Text = "Original game sky"
    elseif not manager.active then self.skyNote.Text = "Preset-matched panoramas"
    elseif manager.sky.assetState == "loading" then self.skyNote.Text = "Loading panoramic sky…"
    elseif manager.sky.assetState == "ready" then self.skyNote.Text = "Panoramic sky ready"
    else self.skyNote.Text = "Native atmosphere · game sky" end
end
function UIController:Minimize()
    if self.dead or self.closing or self.minimized then return end
    self.minimized = true
    self.windowTweens:Reset()
    self.windowTweens:To(self.windowScale, {Scale = 0.97}, 0.23)
    self.tweens:Reset()
    self.windowFade:To(self.windowTweens, 1, 0.23, function()
        self.window.Visible = false
        self.floating.Visible = true
        self.floating.TextTransparency = 1
        self.floating.BackgroundTransparency = 1
        self.windowTweens:To(self.floating, {TextTransparency = 0, BackgroundTransparency = 0}, 0.23)
        self.floatEdge.Transparency = 0.2
    end)
end
function UIController:RestoreWindow()
    if self.dead or self.closing or not self.minimized then return end
    self.minimized = false
    self.windowTweens:Reset()
    self.floating.Visible = false
    self.window.Visible = true
    self.windowFade:To(self.windowTweens, 0, 0.3, function() self:Refresh() end)
    self.windowTweens:To(self.windowScale, {Scale = 1}, 0.34, nil, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end
function UIController:CreateToast()
    local toast = make("Frame", {Name = "Notification", BackgroundColor3 = WHITE,
        BorderSizePixel = 0, Position = UDim2.new(1, 30, 0, 12), Size = UDim2.fromOffset(326, 76),
        Visible = false, ZIndex = 30}, self.safe)
    corner(toast, 14)
    local edge = stroke(toast, WHITE, 0.15)
    gradient(edge, {ColorSequenceKeypoint.new(0, Palette.accent), ColorSequenceKeypoint.new(0.6, Palette.cool),
        ColorSequenceKeypoint.new(1, rgb(70, 60, 101))}, 15)
    gradient(toast, {ColorSequenceKeypoint.new(0, rgb(34, 27, 48)), ColorSequenceKeypoint.new(1, rgb(14, 16, 24))}, 25)
    local mark = label(toast, "Mark", "SX", 13, Palette.accent, UDim2.fromOffset(14, 22), UDim2.fromOffset(28, 28), Enum.Font.GothamBold)
    mark.TextXAlignment = Enum.TextXAlignment.Center
    self.toastTitle = label(toast, "Title", "", 14, Palette.text, UDim2.fromOffset(54, 14), UDim2.new(1, -68, 0, 20), Enum.Font.GothamMedium)
    self.toastMessage = label(toast, "Message", "", 12, Palette.muted, UDim2.fromOffset(54, 36), UDim2.new(1, -68, 0, 27))
    self.toastMessage.TextWrapped = true
    self.toastLine = make("Frame", {Name = "Lifetime", BackgroundColor3 = WHITE, BorderSizePixel = 0,
        Position = UDim2.new(0, 14, 1, -5), Size = UDim2.new(1, -28, 0, 1)}, toast)
    gradient(self.toastLine, {ColorSequenceKeypoint.new(0, Palette.accent), ColorSequenceKeypoint.new(1, Palette.cool)}, 0)
    self.toast = toast
    self.toastFade = VisibilityAnimator.new(toast, self.scope)
    self.toastFade:Set(1)
end
function UIController:Notify(title, message)
    if self.dead or self.closing then return end
    self.toastTweens:Reset()
    local toast = self.toast
    self.toastTitle.Text, self.toastMessage.Text = title, message
    local width = math.min(326, self.safe.AbsoluteSize.X - 24)
    toast.Size = UDim2.fromOffset(width, 76)
    toast.Position = UDim2.new(1, 30, 0, 12)
    self.toastFade:Set(1)
    toast.Visible = true
    self.toastLine.Size = UDim2.new(1, -28, 0, 1)
    local x = math.max(12, (self.safe.AbsoluteSize.X - width) / 2)
    self.toastFade:To(self.toastTweens, 0, 0.32)
    self.toastTweens:To(toast, {Position = UDim2.fromOffset(x, 12)}, 0.32, function()
        self.toastTweens:To(self.toastLine, {Size = UDim2.fromOffset(0, 1)}, 3, nil, Enum.EasingStyle.Linear)
        self.toastTweens:After(3, function()
            self.toastFade:To(self.toastTweens, 1, 0.28)
            self.toastTweens:To(toast, {Position = UDim2.new(1, 30, 0, 12)}, 0.28, function()
                toast.Visible = false
            end)
        end)
    end, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end
function UIController:Close()
    if self.dead or self.closing then return end
    self.closing = true
    self.windowTweens:Reset()
    self.toastTweens:Reset()
    self.toast.Visible = false
    -- Restoration starts immediately; the manager's final Destroy is also safe mid-transition.
    self.manager:DisableAll(false, true)
    self.tweens:Reset()
    self.windowFade:To(self.windowTweens, 1, 0.28)
    self.windowTweens:To(self.windowScale, {Scale = 0.98}, 0.28)
    self.windowTweens:After(0.76, function() self.manager:Destroy() end)
end
function UIController:Destroy()
    if self.dead then return end
    self.dead = true
    self.tweens:Destroy()
    self.windowTweens:Destroy()
    self.toastTweens:Destroy()
    self.scope:Destroy()
    self.screen:Destroy()
end

local manager = ShaderManager.new()
local ui
local ok, err = xpcall(function()
    ui = UIController.new(manager)
    manager.onChanged = function() ui:Refresh() end
    manager.onNotify = function(title, message) ui:Notify(title, message) end
    manager.onDestroy = function() ui:Destroy() end
    manager:Start()
end, debug.traceback)
if not ok then
    manager:Destroy()
    if ui then ui:Destroy() end
    local orphan = playerGui:FindFirstChild(GUI_NAME)
    if orphan and orphan:GetAttribute(OWNER) then orphan:Destroy() end
    warn("[Shaders X] Could not initialize: " .. tostring(err))
    return
end
-- Dot-call public API for future integration. No global overwrite and no persistent gameplay hooks.
return {
    Activate = function(name) return manager:Activate(name) end,
    DisableAll = function() manager:DisableAll() end,
    SetQuality = function(name) return manager:SetQuality(name) end,
    SetSkybox = function(enabled) return manager:SetSkybox(enabled) end,
    Minimize = function() ui:Minimize() end,
    Restore = function() ui:RestoreWindow() end,
    Destroy = function() manager:Destroy() end,
    GetState = function()
        return {Active = manager.active, Quality = manager.quality, CustomSkybox = manager.customSky,
            Phase = manager.phase, SkyAssets = manager.sky.assetState, Closed = manager.dead}
    end,
}
