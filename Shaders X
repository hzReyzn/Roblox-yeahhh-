-- LightingController: hold foreign instances intact, edit only saved Lighting properties.
local LIGHT_KEYS = {"ClockTime", "GeographicLatitude", "Brightness", "ExposureCompensation", "Ambient", "OutdoorAmbient",
    "ColorShift_Top", "ColorShift_Bottom", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "ShadowSoftness", "GlobalShadows"}
local LightingController = {}
LightingController.__index = LightingController
function LightingController.new(transitions)
    return setmetatable({transitions = transitions, session = nil}, LightingController)
end
function LightingController:Capture()
    if self.session then return end
    -- Set the transaction record before making changes so errors can always roll back.
    local s = {original = snapshot(Lighting, LIGHT_KEYS), suspended = {}, effects = {}}
    self.session = s
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Atmosphere") then
            s.suspended[child] = {parent = Lighting}
            child.Parent = nil
        elseif child:IsA("ColorCorrectionEffect") or child:IsA("BloomEffect")
            or child:IsA("SunRaysEffect") or child:IsA("DepthOfFieldEffect") then
            s.suspended[child] = {enabled = child.Enabled}
            child.Enabled = false
        end
    end
    -- Camera-local gameplay effects are left alone (damage feedback, underwater effects, etc.).
    local function effect(class, name, initial)
        local object = owned(class, name, nil, initial)
        s.effects[name] = object
        object.Parent = Lighting
        return object
    end
    effect("Atmosphere", "Atmosphere", {Density = 0, Offset = 0, Color = WHITE, Decay = WHITE, Haze = 0, Glare = 0})
    effect("ColorCorrectionEffect", "Grade", {Brightness = 0, Contrast = 0, Saturation = 0, TintColor = WHITE})
    effect("BloomEffect", "Bloom", {Intensity = 0, Size = 20, Threshold = 1.6, Enabled = false})
    effect("SunRaysEffect", "Rays", {Intensity = 0, Spread = 0.78, Enabled = false})
    effect("DepthOfFieldEffect", "Depth", {FarIntensity = 0, NearIntensity = 0, FocusDistance = 120, InFocusRadius = 100, Enabled = false})
end
function LightingController:Apply(preset, profile, duration)
    self:Capture()
    local effects = self.session.effects
    local goals = table.clone(preset.light)
    local time = goals.ClockTime
    goals.ClockTime = nil
    Lighting.GlobalShadows = true
    self.transitions:Clock(time, duration)
    self.transitions:To(Lighting, goals, duration)
    local atmosphere = table.clone(preset.atmosphere)
    atmosphere.Haze *= profile.haze
    atmosphere.Glare *= profile.rays
    self.transitions:To(effects.Atmosphere, atmosphere, duration)
    local grade = table.clone(preset.grade)
    grade.Contrast *= profile.grade
    grade.Saturation *= profile.grade
    grade.Brightness *= profile.grade
    self.transitions:To(effects.Grade, grade, duration)
    local bloom = table.clone(preset.bloom)
    bloom.Intensity *= profile.bloom
    effects.Bloom.Enabled = true
    effects.Rays.Enabled = true
    effects.Depth.Enabled = true
    self.transitions:To(effects.Bloom, bloom, duration, function()
        effects.Bloom.Enabled = profile.bloom > 0
    end)
    self.transitions:To(effects.Rays, {Intensity = preset.rays * profile.rays}, duration, function()
        effects.Rays.Enabled = preset.rays * profile.rays > 0
    end)
    local depth = preset.dof and profile.dof or 0
    self.transitions:To(effects.Depth, {FarIntensity = depth}, duration, function()
        effects.Depth.Enabled = depth > 0
    end)
end
function LightingController:FadeOut(duration)
    local s = self.session
    if not s then return end
    local goals = table.clone(s.original)
    local time = goals.ClockTime
    goals.ClockTime, goals.GlobalShadows = nil, nil
    self.transitions:Clock(time, duration)
    self.transitions:To(Lighting, goals, duration)
    local e = s.effects
    local originalAtmosphere
    for object, saved in pairs(s.suspended) do
        if saved.parent and object:IsA("Atmosphere") then originalAtmosphere = object; break end
    end
    local atmosphericGoal = originalAtmosphere and snapshot(originalAtmosphere,
        {"Density", "Offset", "Color", "Decay", "Glare", "Haze"}) or {Density = 0, Haze = 0, Glare = 0}
    self.transitions:To(e.Atmosphere, atmosphericGoal, duration)
    self.transitions:To(e.Grade, {Brightness = 0, Contrast = 0, Saturation = 0, TintColor = WHITE}, duration)
    self.transitions:To(e.Bloom, {Intensity = 0}, duration)
    self.transitions:To(e.Rays, {Intensity = 0}, duration)
    self.transitions:To(e.Depth, {FarIntensity = 0}, duration)
end
function LightingController:Restore()
    local s = self.session
    if not s then return end
    self.session = nil
    for _, effect in pairs(s.effects) do pcall(function() effect:Destroy() end) end
    restore(Lighting, s.original)
    for object, saved in pairs(s.suspended) do
        pcall(function()
            if saved.parent then
                -- Respect deliberate reparenting/deletion by the game while the preset was active.
                if object.Parent == nil then object.Parent = saved.parent end
            elseif object.Enabled == false then
                object.Enabled = saved.enabled
            end
        end)
    end
end

-- SkyboxManager: six independent image cubes, lazy preload and lossless restoration.
-- Audited 2026-10-18: economy.roblox.com/v2/assets/<id>/details reports Image (type 1),
-- thumbnails.roblox.com/v1/assets reports Completed for every face. Thumbnails were inspected.
-- Those checks do NOT guarantee permission in every experience; PreloadAsync below is the gate.
-- Face order: Back, Down, Front, Left, Right, Up. Map by the image's named face, not list position.
-- Aurora uses a night cube plus native ribbons; Fog uses a hazy sea-sky cube plus Atmosphere.
local FACE_KEYS = {"SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp"}
local SKY_IMAGES = {
    ["Golden Hour"] = {323494035, 323494368, 323494130, 323494252, 323494067, 323493360},
    Moonlight = {48020371, 48020144, 48020234, 48020211, 48020254, 48020383},
    ["Cinematic Realism"] = {153695320, 153695352, 153695383, 153695414, 153695452, 153695471},
    ["Aurora Borealis"] = {12064107, 12064152, 12064121, 12063984, 12064115, 12064131},
    Overcast = {4498828382, 4498828812, 4498829917, 4498830417, 4498830911, 4498831746},
    ["Volumetric Fog"] = {153767200, 153767216, 153767231, 153767241, 153767266, 153767288},
}
local SkyboxManager = {}
SkyboxManager.__index = SkyboxManager
function SkyboxManager.new(scope)
    return setmetatable({scope = scope, originals = {}, foreignClouds = {}, cache = {}, assetState = "idle",
        sky = nil, clouds = nil, captured = false}, SkyboxManager)
end
function SkyboxManager:Prepare(name)
    self.requested = name
    local existing = self.cache[name]
    if existing then self.assetState = existing.state; return end
    local entry = {state = "loading", faces = {}, assets = {}}
    for index, id in ipairs(SKY_IMAGES[name]) do
        local uri = "rbxassetid://" .. tostring(id)
        entry.faces[FACE_KEYS[index]] = uri
        table.insert(entry.assets, uri)
    end
    self.cache[name] = entry
    self.assetState = "loading"
    local settled = false
    local function finish(state)
        if settled or self.scope.dead then return end
        settled, entry.state = true, state
        if self.requested == name then self.assetState = state end
        if self.onResolved then self.onResolved(name, state) end
    end
    self.scope:Delay(8, function() finish("unavailable") end)
    local thread
    thread = task.defer(function()
        local statuses = {}
        local ok = pcall(function()
            ContentProvider:PreloadAsync(entry.assets, function(id, status)
                local key = tostring(id):match("id=(%d+)") or tostring(id):match("(%d+)$") or tostring(id)
                statuses[key] = status
            end)
        end)
        for _, id in ipairs(entry.assets) do
            local state = statuses[id:match("(%d+)$")]
            if not state then pcall(function() state = ContentProvider:GetAssetFetchStatus(id) end) end
            if state ~= Enum.AssetFetchStatus.Success then ok = false; break end
        end
        self.scope.items[thread] = nil
        finish(ok and "ready" or "unavailable")
    end)
    self.scope:Add(thread, function(t) pcall(task.cancel, t) end)
end
function SkyboxManager:Capture()
    if self.captured then return end
    self.captured = true
    for _, item in ipairs(Lighting:GetChildren()) do
        if item:IsA("Sky") then self.originals[item] = Lighting end
    end
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        for _, item in ipairs(terrain:GetChildren()) do
            if item:IsA("Clouds") then self.foreignClouds[item] = item.Enabled end
        end
    end
end
function SkyboxManager:RestoreSky()
    if self.sky then self.sky:Destroy(); self.sky = nil end
    for sky, parent in pairs(self.originals) do
        pcall(function() if sky.Parent == nil then sky.Parent = parent end end)
    end
end
function SkyboxManager:OriginalSky()
    self:RestoreSky()
    if self.clouds then self.clouds:Destroy(); self.clouds = nil end
    for clouds, enabled in pairs(self.foreignClouds) do
        pcall(function() if clouds.Enabled == false then clouds.Enabled = enabled end end)
    end
end
function SkyboxManager:Apply(name, preset, profile, enabled)
    self:Capture()
    if not enabled then self:OriginalSky(); return end
    local entry = self.cache[name]
    if entry and entry.state == "ready" then
        for sky, parent in pairs(self.originals) do
            pcall(function() if sky.Parent == parent then sky.Parent = nil end end)
        end
        if not self.sky then self.sky = owned("Sky", "Sky", nil) end
        self.sky.Name = "ShadersX_Sky_" .. name:gsub(" ", "")
        set(self.sky, entry.faces)
        set(self.sky, preset.sky)
        -- These panoramas already contain their moon/sun. Avoid a second visible disc.
        self.sky.SunAngularSize, self.sky.MoonAngularSize = 0, 0
        self.sky.Parent = Lighting
    else
        self:RestoreSky()
    end
    -- Native clouds are independent of texture delivery: failed assets must not leave
    -- Overcast as a clear blue sky with a thick blue fog filter.
    for clouds in pairs(self.foreignClouds) do pcall(function() clouds.Enabled = false end) end
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain and profile.clouds then
        if not self.clouds then self.clouds = owned("Clouds", "Clouds", terrain) end
        set(self.clouds, preset.clouds)
        self.clouds.Enabled = true
    elseif self.clouds then self.clouds:Destroy(); self.clouds = nil end
end
function SkyboxManager:Restore()
    self:OriginalSky()
    table.clear(self.originals)
    table.clear(self.foreignClouds)
    self.captured = false
end

-- AuroraController: at most ONE non-collidable anchor and 42 Beams, only for Aurora.
-- Broad, transparent ribbons fade vertically; no particle cloud, imported texture or shader code.
local AuroraController = {}
AuroraController.__index = AuroraController
function AuroraController.new()
    return setmetatable({scope = nil, fade = TransitionManager.new()}, AuroraController)
end
function AuroraController:Stop()
    self.fade:Reset()
    if self.scope then self.scope:Destroy(); self.scope = nil end
    self.alpha = nil
end
function AuroraController:FadeOut(duration)
    if self.alpha then self.fade:To(self.alpha, {Value = 0}, duration) end
end
function AuroraController:Start(profile)
    self:Stop()
    if profile.aurora == 0 then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local scope = CleanupManager.new()
    self.scope = scope
    local anchor = scope:Add(owned("Part", "AuroraAnchor", Workspace, {
        Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
        CastShadow = false, Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1),
        CFrame = CFrame.new(camera.CFrame.Position),
    }))
    local alpha = scope:Add(make("NumberValue", {Value = 0}))
    self.alpha = alpha
    local ribbons = {}
    local color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, rgb(91, 222, 165)),
        ColorSequenceKeypoint.new(0.3, rgb(103, 235, 210)),
        ColorSequenceKeypoint.new(0.62, rgb(109, 159, 230)),
        ColorSequenceKeypoint.new(1, rgb(163, 113, 216)),
    })
    for i = 1, profile.aurora do
        local phase = i * 0.61
        local angle = -1.05 + 2.1 * (i - 1) / math.max(1, profile.aurora - 1)
        local x, z = math.sin(angle) * 940, -math.cos(angle) * 940
        local baseY = 245 + math.sin(phase) * 45
        local a = make("Attachment", {Position = Vector3.new(x, baseY, z)}, anchor)
        local b = make("Attachment", {Position = Vector3.new(x + 45, baseY + 240 + math.cos(phase) * 65, z - 95)}, anchor)
        local ribbon = {a = a, b = b, x = x, z = z, y = baseY, phase = phase, beams = {}}
        for layer = 1, 3 do
            local width = (1800 / profile.aurora) * (0.8 + layer * 0.25)
            local beam = make("Beam", {
                Attachment0 = a, Attachment1 = b, FaceCamera = true,
                Segments = 12, Width0 = width, Width1 = width * 0.42,
                CurveSize0 = 45, CurveSize1 = -65, Color = color,
                LightEmission = 1, LightInfluence = 0, Transparency = NumberSequence.new(1),
            }, anchor)
            table.insert(ribbon.beams, {object = beam, opacity = 0.20 / layer})
        end
        table.insert(ribbons, ribbon)
    end
    local function opacity()
        for _, ribbon in ipairs(ribbons) do
            for _, layer in ipairs(ribbon.beams) do
                local visible = layer.opacity * alpha.Value
                layer.object.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.12, 1 - visible),
                    NumberSequenceKeypoint.new(0.42, 1 - visible * 0.9),
                    NumberSequenceKeypoint.new(0.78, 1 - visible * 0.35), NumberSequenceKeypoint.new(1, 1),
                })
            end
        end
    end
    scope:Connect(alpha:GetPropertyChangedSignal("Value"), opacity)
    self.fade:To(alpha, {Value = 1}, 1.6)
    local accumulator, elapsed = 0, 0
    local rate = profile.hz > 0 and profile.hz or 6
    -- Balanced only follows camera translation; High/Ultra also deform the curtains slowly.
    scope:Connect(RunService.Heartbeat, function(dt)
        accumulator += dt
        if accumulator < 1 / rate then return end
        elapsed += math.min(accumulator, 0.25)
        accumulator = 0
        local current = Workspace.CurrentCamera
        if not current then return end
        anchor.CFrame = CFrame.new(current.CFrame.Position)
        if profile.hz == 0 then return end
        for _, ribbon in ipairs(ribbons) do
            local sway = math.sin(elapsed * 0.22 + ribbon.phase) * 24
            local lift = math.sin(elapsed * 0.15 + ribbon.phase) * 12
            ribbon.a.Position = Vector3.new(ribbon.x + sway, ribbon.y + lift, ribbon.z)
            ribbon.b.Position = Vector3.new(ribbon.x + 45 - sway * 0.65,
                ribbon.y + 240 + math.cos(ribbon.phase) * 65 + lift * 1.5, ribbon.z - 95)
        end
    end)
end
function AuroraController:Destroy()
    self:Stop()
    self.fade:Destroy()
end

-- ShaderManager: transactional lifecycle, one requested preset, one original-state snapshot.
local ShaderManager = {}
ShaderManager.__index = ShaderManager
function ShaderManager.new()
    local self = setmetatable({active = nil, quality = "Balanced", customSky = true, phase = "Idle",
        dead = false, scope = CleanupManager.new(), transitions = TransitionManager.new()}, ShaderManager)
    self.light = LightingController.new(self.transitions)
    self.sky = SkyboxManager.new(self.scope)
    self.aurora = AuroraController.new()
    return self
end
function ShaderManager:Emit()
    if self.onChanged then self.onChanged() end
end
function ShaderManager:Notify(title, message)
    if self.onNotify and not self.dead then self.onNotify(title, message) end
end
function ShaderManager:Recover(message)
    self.transitions:Reset()
    self.aurora:Stop()
    self.sky:Restore()
    self.light:Restore()
    self.active, self.phase = nil, "Idle"
    warn("[Shaders X] Restored after an error: " .. tostring(message))
    self:Emit()
    self:Notify("Preset unavailable", "Original lighting has been restored.")
end
function ShaderManager:Guard(callback)
    if self.dead then return end
    local ok, err = xpcall(callback, debug.traceback)
    if not ok then self:Recover(err) end
    return ok
end
function ShaderManager:Activate(name, silent)
    if self.dead or not Presets[name] then return false end
    return self:Guard(function()
        self.transitions:Reset()
        self.light:Capture()
        self.sky:Capture()
        self.active, self.phase = name, "Applying"
        if self.customSky then self.sky:Prepare(name) end
        self:Emit()
        self.aurora:FadeOut(0.24)
        -- A small exposure dip coordinates the discrete sky swap; texture URLs are never tweened.
        -- Bound it against the session/preset, so repeated taps cannot accumulate a black screen.
        local currentExposure = Lighting.ExposureCompensation
        local minimumExposure = math.min(self.light.session.original.ExposureCompensation,
            Presets[name].light.ExposureCompensation) - 0.10
        local dip = math.min(currentExposure, math.max(minimumExposure, currentExposure - 0.10))
        self.transitions:To(Lighting, {ExposureCompensation = dip}, 0.24)
        self.transitions:After(0.24, function()
            self:Guard(function()
                local preset, profile = Presets[name], GraphicsProfiles[self.quality]
                self.aurora:Stop()
                self.sky:Apply(name, preset, profile, self.customSky)
                self.light:Apply(preset, profile, 1.1)
                if preset.aurora and self.customSky then self.aurora:Start(profile) end
                self.transitions:After(1.12, function()
                    self.phase = "Active"
                    self:Emit()
                    if not silent then self:Notify(name, "Environment enabled · " .. self.quality) end
                end)
            end)
        end)
    end)
end
function ShaderManager:DisableAll(immediate, silent)
    if self.dead then return end
    self.transitions:Reset()
    self.active = nil
    if immediate or not self.light.session then
        self.aurora:Stop(); self.sky:Restore(); self.light:Restore()
        self.phase = "Idle"
        self:Emit()
        return
    end
    self.phase = "Restoring"
    self:Emit()
    self:Guard(function()
        self.aurora:FadeOut(0.6)
        self.light:FadeOut(0.7)
        self.transitions:After(0.35, function() self.sky:Restore() end)
        self.transitions:After(0.72, function()
            self.transitions:Reset()
            self.aurora:Stop(); self.sky:Restore(); self.light:Restore()
            self.phase = "Idle"
            self:Emit()
            if not silent then self:Notify("Shaders disabled", "Original environment restored.") end
        end)
    end)
end
function ShaderManager:SetQuality(name)
    if self.dead or not GraphicsProfiles[name] or name == "Order" then return false end
    if self.quality == name then return true end
    self.quality = name
    self:Emit()
    if self.active then self:Activate(self.active, true) end
    self:Notify("Visual quality", name .. " profile selected.")
    return true
end
function ShaderManager:SetSkybox(enabled)
    if self.dead or type(enabled) ~= "boolean" then return false end
    if self.customSky == enabled then return true end
    self.customSky = enabled
    self:Emit()
    if self.active then self:Activate(self.active, true) end
    self:Notify("Custom skybox", enabled and "Atmospheric sky enabled." or "Game sky preserved.")
    return true
end
function ShaderManager:Start()
    self.sky.onResolved = function(name, state)
        if self.dead or self.active ~= name or not self.customSky then return end
        -- Reuse the cancellable transition so a late texture never swaps into a different preset.
        self:Activate(name, true)
        if state ~= "ready" then self:Notify("Skybox unavailable", "Native atmosphere remains active.") end
    end
end
function ShaderManager:Destroy()
    if self.dead then return end
    self.dead = true
    self.sky.onResolved = nil
    self.transitions:Destroy()
    self.aurora:Destroy()
    self.sky:Restore()
    self.light:Restore()
    self.scope:Destroy()
    self.active, self.phase = nil, "Closed"
    self.onChanged, self.onNotify = nil, nil
    if self.onDestroy then self.onDestroy() end
end

-- UI fades animate transparency directly. A dark UIGradient on CanvasGroup tints ALL
-- descendants; ordinary Frames keep text independent and avoid mobile render-texture caps.
local VisibilityAnimator = {}
VisibilityAnimator.__index = VisibilityAnimator
function VisibilityAnimator.new(root, scope)
    local self = setmetatable({root = root, entries = {}, proxy = scope:Add(make("NumberValue", {Value = 0}))}, VisibilityAnimator)
    local nodes = root:GetDescendants()
    table.insert(nodes, root)
    for _, node in ipairs(nodes) do
        local keys = {}
        if node:IsA("GuiObject") then table.insert(keys, "BackgroundTransparency") end
        if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
            table.insert(keys, "TextTransparency"); table.insert(keys, "TextStrokeTransparency")
        elseif node:IsA("ImageLabel") or node:IsA("ImageButton") then table.insert(keys, "ImageTransparency") end
        if node:IsA("UIStroke") then table.insert(keys, "Transparency") end
        if node:IsA("ScrollingFrame") then table.insert(keys, "ScrollBarImageTransparency") end
        if #keys > 0 then self.entries[node] = snapshot(node, keys) end
    end
    scope:Connect(self.proxy:GetPropertyChangedSignal("Value"), function() self:Render() end)
    return self
end
function VisibilityAnimator:Render()
    local alpha = self.proxy.Value
    self.root:SetAttribute("VisibilityAlpha", alpha)
    for node, properties in pairs(self.entries) do
        for property, base in pairs(properties) do node[property] = base + (1 - base) * alpha end
    end
end
function VisibilityAnimator:Set(alpha)
    self.proxy.Value = alpha
    self:Render()
end
function VisibilityAnimator:Base(node, property, value)
    if self.entries[node] then self.entries[node][property] = value end
    node[property] = value + (1 - value) * self.proxy.Value
end
function VisibilityAnimator:To(transitions, alpha, duration, callback)
    transitions:To(self.proxy, {Value = alpha}, duration, callback)
end

-- UIController: compact scrollable panel; all visual controls share the same event-driven system.
local UIController = {}
UIController.__index = UIController
local Palette = {base = rgb(20, 21, 29), raised = rgb(36, 37, 49), border = rgb(89, 86, 112),
    text = rgb(247, 247, 255), muted = rgb(186, 187, 207), accent = rgb(190, 157, 255), cool = rgb(156, 211, 244)}
local function corner(parent, radius)
    return make("UICorner", {CornerRadius = UDim.new(0, radius)}, parent)
end
local function stroke(parent, color, transparency, thickness)
    return make("UIStroke", {ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = color or Palette.border,
        Transparency = transparency or 0, Thickness = thickness or 1}, parent)
end
local function gradient(parent, colors, rotation)
    return make("UIGradient", {Color = ColorSequence.new(colors), Rotation = rotation or 0}, parent)
end
local function label(parent, name, text, size, color, position, dimensions, weight)
    return make("TextLabel", {Name = name, BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = text, Font = weight or Enum.Font.Gotham, TextSize = size, TextColor3 = color or Palette.text,
        TextTransparency = 0, TextStrokeTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        Position = position, Size = dimensions, ZIndex = 3}, parent)
end
local function button(parent, name, text, position, dimensions)
    local b = make("TextButton", {Name = name, Text = text, Font = Enum.Font.GothamMedium,
        TextSize = 14, TextColor3 = Palette.text, TextTransparency = 0, TextStrokeTransparency = 1, BorderSizePixel = 0,
        BackgroundColor3 = Palette.raised, AutoButtonColor = false,
        Position = position, Size = dimensions, ZIndex = 3}, parent)
    corner(b, 10)
    return b
end
function UIController:Bind(buttonObject, callback)
    local scale = make("UIScale", {Scale = 1}, buttonObject)
    local function ready()
        return not self.dead and not self.closing and not self.minimized
            and (not self.windowFade or self.windowFade.proxy.Value == 0)
    end
    self.scope:Connect(buttonObject.InputBegan, function(input)
        if not ready() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.tweens:To(scale, {Scale = 0.976}, 0.10)
        end
    end)
    self.scope:Connect(buttonObject.InputEnded, function(input)
        if not ready() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.tweens:To(scale, {Scale = 1}, 0.2)
        end
    end)
    self.scope:Connect(buttonObject.MouseEnter, function()
        if not ready() then return end
        self.tweens:To(buttonObject, {BackgroundTransparency = 0.12}, 0.18)
    end)
    self.scope:Connect(buttonObject.MouseLeave, function()
        if not ready() then return end
        self.tweens:To(buttonObject, {BackgroundTransparency = 0}, 0.18)
        self.tweens:To(scale, {Scale = 1}, 0.2)
    end)
    self.scope:Connect(buttonObject.Activated, function()
        if not self.dead and not self.closing and not self.minimized then
            self.tweens:To(scale, {Scale = 1}, 0.2)
            callback()
        end
    end)
end
function UIController:Drag(handle, target, onTap)
    local inputSource, start, startPosition, moved
    local function finish()
        if not inputSource then return end
        local tap = not moved
        inputSource = nil
        if tap and onTap and not self.closing then onTap() end
    end
    self.scope:Connect(handle.InputBegan, function(input)
        if self.closing or inputSource then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        self.windowTweens:Cancel(target)
        inputSource, start, moved = input, input.Position, false
        startPosition = target.AbsolutePosition - self.safe.AbsolutePosition
    end)
    self.scope:Connect(UserInputService.InputChanged, function(input)
        if not inputSource then return end
        local matching = (inputSource.UserInputType == Enum.UserInputType.Touch and input == inputSource)
            or (inputSource.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
        if not matching then return end
        local delta = input.Position - start
        if delta.Magnitude > 5 then moved = true end
        if not moved then return end
        local bounds, size = self.safe.AbsoluteSize, target.AbsoluteSize
        -- Keep the header reachable; dragging is otherwise unrestricted within the usable display.
        local x = math.clamp(startPosition.X + delta.X, -size.X + 70, math.max(0, bounds.X - 70))
        local y = math.clamp(startPosition.Y + delta.Y, 0, math.max(0, bounds.Y - 52))
        target.Position = UDim2.fromOffset(x, y)
        if target == self.window then self.windowMoved = true else self.floatingMoved = true end
    end)
    self.scope:Connect(UserInputService.InputEnded, function(input)
        if inputSource == input or (inputSource and inputSource.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1) then finish() end
    end)
    self.scope:Connect(UserInputService.WindowFocusReleased, function() inputSource = nil end)
end
